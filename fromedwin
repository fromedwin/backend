    echo "█████╗  ██████╔╝██║   ██║██╔████╔██║█████╗  ██║  ██║██║ █╗ ██║██║██╔██╗ ██║"
    echo "██╔══╝  ██╔══██╗██║   ██║██║╚██╔╝██║██╔══╝  ██║  ██║██║███╗██║██║██║╚██╗██║"
